# Copy to .env and replace every example secret before starting Docker Compose.
API_PORT=8000
POSTGRES_USER=resiliencelab
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=resiliencelab
RESILIENCELAB_STORE=./results
RESILIENCELAB_AUTH_MODE=api_key
RESILIENCELAB_API_KEYS=replace-with-a-long-random-api-key
RESILIENCELAB_DATABASE_URL=postgresql+psycopg://resiliencelab:replace-with-a-long-random-password@postgres:5432/resiliencelab
